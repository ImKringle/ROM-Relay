    "react-dom": "19.3.1",
    "react-router": "7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
