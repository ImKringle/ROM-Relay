# ROM Relay secrets. One file, two runners: the NATIVE binary (ROMRelay.exe)
# reads it from the same directory as config.ini, and `docker compose up`
# reads it from the repo root for both compose variable substitution and the
# container's own environment. Keys each runner doesn't use are ignored, so
# it's safe to fill in both sections even if you only run one of them.
#
# Copy to .env and fill in as needed. NEVER commit .env. Values are loaded
# only at runtime. Anything set in the real process environment overrides the
# file here.
#
# Leave a value blank to disable that feature/credential. Tokens, when set, are
# validated for minimum length at startup.

# Viewer (remote access) token for the public catalog. Minimum 24 characters.
REMOTE_ACCESS_TOKEN=

# Admin token guarding the patch workspace and admin APIs. Minimum 24 characters.
# Must differ from REMOTE_ACCESS_TOKEN. Blank = auto-generated at startup.
ADMIN_ACCESS_TOKEN=

# Password for the built-in "admin" login (the across-suite sign-in at /login).
# Blank = a random password is generated and printed once in the startup log.
ADMIN_PASSWORD=

# IGDB metadata credentials (only used when [metadata.igdb] enabled = true).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# SFTP password for remote ROM search (only used when [remote_search] enabled = true).
REMOTE_SEARCH_PASSWORD=

# Database backend. Leave blank to use the SQLite file from config.ini
# ([library] database_path). Set a postgres:// URL to use PostgreSQL instead
# (recommended for multi-user / large deployments); when set, database_path is
# ignored. Example:
# DATABASE_URL=postgres://romrelay:password@database:5432/romrelay?sslmode=disable
DATABASE_URL=

# PKHeX save-parsing sidecar URL. Enables Pokémon save upload / Living Dex. In the
# Docker stack this is set automatically (http://pkhex:8081). For a native run,
# start the sidecar (sidecar/pkhex) yourself and point this at it. Blank = Pokémon
# features disabled.
POKEMON_SIDECAR_URL=

# --- Docker stack only (docker-compose.yml). Ignored by the native binary. ---

# Strong password for the bundled Postgres container. Required to run
# `docker compose up`; there is no default.
POSTGRES_PASSWORD=

# Host port to publish the catalog on.
HTTP_PORT=8080

# Your ROM library on the host. Windows (Docker Desktop) example:
# ROMS_DIR=D:/Rom Relay/platforms. Defaults to ./data/roms if unset.
ROMS_DIR=

# Optional 3DS drivers directory on the host (read-only mount), for
# boot9.bin-based .3ds/.cci -> .cia conversion. Defaults to ./drivers if unset.
DRIVERS_DIR=

# The address to advertise in catalog/QR/download URLs. Behind a Cloudflare
# Tunnel or any reverse proxy, use its public https URL, e.g.
# PUBLIC_BASE_URL=https://romrelay.kringleslab.dev
# Blank in a container falls back to an unreachable compose-network IP, so set
# this (or ADVERTISE_IP below) for working QR codes and download links.
PUBLIC_BASE_URL=

# LAN fallback address for QR/download links when PUBLIC_BASE_URL is blank
# (e.g. local-only testing without the tunnel). Not read if PUBLIC_BASE_URL is
# set. Example: ADVERTISE_IP=192.168.1.50
ADVERTISE_IP=
